{
  "rules": [
    {
      "allowed": {
        "origins": ["https://loopyclipper.vercel.app", "http://localhost:5174"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
