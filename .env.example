# Browser-visible Supabase publishable key only; never put server secrets under NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:5174
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Connect > Transaction pooler URI, server-only. TLS is required by default.
DATABASE_URL=
# Private Cloudflare R2 bucket, Object Read & Write token scoped to this bucket.
R2_ACCOUNT_ID=
R2_BUCKET=loofy-clip
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Random secret shared only with processor/.env (at least 32 random bytes).
PROCESSOR_TOKEN=
# UUIDs from verified Supabase Auth users, comma-separated. Never an email or local demo ID.
ADMIN_USER_IDS=
# Leave false for non-commercial testing. Commercial usage requires an eligible hosting plan.
ENABLE_SUBSCRIPTIONS=false
